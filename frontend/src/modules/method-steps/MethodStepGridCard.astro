---
interface Props {
  variant: 'featured' | 'step'
  number?: number
  title: string
  description?: string
}

const {variant, number, title, description} = Astro.props

const cardClass =
  'group flex h-full min-h-[232px] flex-col justify-center rounded-[4px] border-l-[3px] border-magenta bg-black p-8 transition-[background-color,box-shadow] duration-300 ease-[var(--ease-out)] hover:bg-magenta hover:shadow-[0_12px_28px_rgba(139,24,88,0.28)]'

const textTransition = 'transition-colors duration-300 ease-[var(--ease-out)]'
const descriptionClass = `m-0 text-base leading-5 text-white/75 ${textTransition} group-hover:text-white/90`
---

{
  variant === 'featured' ? (
    <article class={cardClass}>
      <h3 class={`m-0 text-2xl uppercase leading-normal text-white ${textTransition}`}>
        {title}
      </h3>
      {description && (
        <p class={`${descriptionClass} mt-2.5 max-w-[353px]`}>
          {description}
        </p>
      )}
    </article>
  ) : (
    <article class={cardClass}>
      <div class="flex flex-col gap-2.5 pl-4">
        {number !== undefined && (
          <span
            class={`flex size-[42px] items-center justify-center rounded-full bg-magenta text-xl leading-5 text-white ${textTransition} group-hover:bg-black`}
          >
            {number}
          </span>
        )}
        <h3 class={`m-0 text-base leading-5 text-white ${textTransition}`}>
          {title}
        </h3>
        {description && <p class={descriptionClass}>{description}</p>}
      </div>
    </article>
  )
}
