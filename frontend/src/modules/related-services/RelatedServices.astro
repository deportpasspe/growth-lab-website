---
interface Props {
  heading: string
  items: {
    title: string
    description?: string
    icon?: 'calendar' | 'planning' | 'money'
    href: string
  }[]
}

const {heading, items} = Astro.props

const icons = {
  calendar: '/assets/figma/services/industry-calendar.svg',
  planning: '/assets/figma/services/industry-planning.svg',
  money: '/assets/figma/services/industry-money.svg',
}
---

<section class="overflow-x-clip bg-black px-6 py-[72px] text-white sm:px-[42px]">
  <div class="mx-auto max-w-[1356px]" data-reveal-group="100">
    <h2 class="m-0 max-w-[756px] text-[clamp(2rem,3vw,2.625rem)] leading-[1.03] uppercase" data-reveal="text">
      {heading}
    </h2>
    <div class="mt-12 grid grid-cols-1 gap-4 lg:grid-cols-3">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="group flex min-w-0 items-center gap-4 rounded-[4px] border border-white/25 p-4 transition-[border-color,background-color,transform] duration-300 hover:-translate-y-0.5 hover:border-magenta hover:bg-[#150e0e] active:scale-[0.99] focus-visible:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-magenta sm:p-6"
            data-reveal
          >
            <img
              src={icons[item.icon ?? 'calendar']}
              alt=""
              class="h-[54px] w-[54px] shrink-0 max-w-none"
              width="54"
              height="54"
            />
            <div class="min-w-0">
              <h3 class="m-0 text-[22px] leading-[1.05]">{item.title}</h3>
              {item.description && (
                <p class="mb-0 mt-2.5 text-base leading-[20px] text-white/75">{item.description}</p>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
