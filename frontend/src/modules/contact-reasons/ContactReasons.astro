---
import type {Locale} from '../../i18n/routes'
import {t} from '../../i18n'
import {contactReasons} from '../contactPageFixtures'

interface Props {
  locale: Locale
}

const {locale} = Astro.props
const reasons = contactReasons(locale)
---

<section class="bg-surface px-6 py-16 sm:px-[42px] sm:py-[72px]">
  <div class="mx-auto max-w-[1356px]" data-reveal-group="110">
    <h2
      class="m-0 max-w-[627px] text-[clamp(1.75rem,3vw,2.625rem)] uppercase leading-[1.05] text-navy"
      data-reveal="text"
    >
      {t(locale, 'contact.reasonsHeading')}
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-3">
      {
        reasons.map((reason) => (
          <article class="flex min-h-[305px] flex-col gap-6 bg-magenta p-6" data-reveal>
            <img
              src={reason.image}
              alt=""
              class="size-[150px] rounded-full object-cover"
              width="150"
              height="150"
            />
            <div class="flex flex-col gap-3">
              <h3 class="m-0 text-[22px] leading-normal text-white">{reason.title}</h3>
              <p class="m-0 text-base leading-normal text-white/75">{reason.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
