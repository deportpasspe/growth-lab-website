---
import type {ContactReasonTone} from '../contactPageFixtures'

interface Props {
  image: string
  title: string
  description: string
  tone: ContactReasonTone
}

const {image, title, description, tone} = Astro.props

const toneClass: Record<ContactReasonTone, string> = {
  magenta: 'bg-magenta',
  teal: 'bg-[#054e58]',
  navyDeep: 'bg-[#012751]',
}
---

<article
  class:list={[
    'flex min-h-[305px] flex-col gap-6 p-6 lg:flex-1',
    toneClass[tone],
  ]}
  data-reveal
>
  <div class="reason-avatar relative h-[150px] w-[150px] shrink-0 overflow-hidden rounded-full">
    <img src={image} alt="" width="150" height="150" loading="lazy" decoding="async" />
  </div>
  <div class="flex flex-col gap-3">
    <h3 class="m-0 text-[22px] leading-none text-white">{title}</h3>
    <p class="m-0 text-base leading-[1.25] text-white/75">{description}</p>
  </div>
</article>

<style>
  .reason-avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    pointer-events: none;
  }
</style>
