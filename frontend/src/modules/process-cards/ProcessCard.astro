---
export type ProcessCardTone = 'teal' | 'magenta' | 'cream' | 'navy'

interface Props {
  index: number
  title: string
  description?: string
  tone: ProcessCardTone
  expanded?: boolean
  class?: string
}

const {index, title, description, tone, expanded = false, class: className} = Astro.props

const formatStep = (stepIndex: number) => String(stepIndex + 1).padStart(2, '0')

const toneStyles: Record<
  ProcessCardTone,
  {bg: string; text: string; plusIcon: string; minusIcon: string}
> = {
  teal: {
    bg: 'bg-[#054e58]',
    text: 'text-white',
    plusIcon: '/assets/figma/services/process/icon-plus.svg',
    minusIcon: '/assets/figma/services/process/icon-minus.svg',
  },
  magenta: {
    bg: 'bg-[#8b1758]',
    text: 'text-white',
    plusIcon: '/assets/figma/services/process/icon-plus.svg',
    minusIcon: '/assets/figma/services/process/icon-minus.svg',
  },
  cream: {
    bg: 'bg-[#ffeca7]',
    text: 'text-[#150e0e]',
    plusIcon: '/assets/figma/services/process/icon-plus-dark.svg',
    minusIcon: '/assets/figma/services/process/icon-minus-dark.svg',
  },
  navy: {
    bg: 'bg-[#051a3b]',
    text: 'text-white',
    plusIcon: '/assets/figma/services/process/icon-plus.svg',
    minusIcon: '/assets/figma/services/process/icon-minus.svg',
  },
}

const styles = toneStyles[tone]
---

<button
  type="button"
  class:list={[
    'group relative flex min-w-0 flex-col rounded-[4px] p-6 text-left transition-[border-color,box-shadow,transform] duration-300 ease-[var(--ease-out)] hover:-translate-y-0.5 hover:shadow-[0_12px_28px_rgba(0,0,0,0.18)] active:scale-[0.99] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-magenta',
    styles.bg,
    styles.text,
    expanded && tone === 'teal' && 'border-2 border-[#447a82]',
    className,
  ]}
  data-process-card
  data-tone={tone}
  data-index={index}
  data-reveal
  aria-expanded={expanded}
>
  {
    expanded && tone === 'teal' && (
      <img
        src="/assets/figma/services/process/card-decor.svg"
        alt=""
        class="pointer-events-none absolute inset-0 h-full w-full rounded-[2px] object-cover mix-blend-luminosity"
        aria-hidden="true"
      />
    )
  }

  <span class="relative z-[1] mb-auto flex items-start justify-between gap-4">
    <span class="font-display text-[36px] leading-none">{formatStep(index)}</span>
    <span class="relative h-7 w-7 shrink-0">
      <img
        src={styles.plusIcon}
        alt=""
        width="28"
        height="28"
        class:list={[
          'absolute inset-0 h-7 w-7 transition-opacity duration-300',
          expanded ? 'opacity-0' : 'opacity-100',
        ]}
        data-process-icon="plus"
      />
      <img
        src={styles.minusIcon}
        alt=""
        width="28"
        height="28"
        class:list={[
          'absolute inset-0 h-7 w-7 transition-opacity duration-300',
          expanded ? 'opacity-100' : 'opacity-0',
        ]}
        data-process-icon="minus"
      />
    </span>
  </span>

  <div class="relative z-[1] mt-6 flex flex-col gap-3">
    <h3 class="m-0 text-[22px] leading-[1.09]">{title}</h3>
    {
      description && (
        <div
          class:list={[
            'grid transition-[grid-template-rows,opacity] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]',
            expanded ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0',
          ]}
          data-process-description
        >
          <p class="m-0 overflow-hidden text-base leading-5">{description}</p>
        </div>
      )
    }
  </div>
</button>
