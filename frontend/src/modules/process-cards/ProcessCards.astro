---
import ProcessCard, {type ProcessCardTone} from './ProcessCard.astro'
import ProcessPathCard from './ProcessPathCard.astro'

interface Props {
  id?: string
  heading: string
  layout?:
    | 'accordionRow'
    | 'accordionColumns'
    | 'accordionSplit'
    | 'dualPaths'
    | 'threeEqual'
    | 'threeMixed'
    | 'twoWide'
  steps: {title: string; description?: string}[]
}

const {id, heading, layout = 'accordionRow', steps} = Astro.props

const tones: ProcessCardTone[] = ['teal', 'magenta', 'cream', 'navy']
const splitTones: ProcessCardTone[] = ['teal', 'navy', 'magenta', 'cream']
const pathTones = ['teal', 'magenta'] as const

const formatStep = (index: number) => String(index + 1).padStart(2, '0')

const isAccordionLayout =
  layout === 'accordionRow' || layout === 'accordionColumns' || layout === 'accordionSplit'
---

<section id={id} class="relative overflow-hidden bg-black px-6 py-[72px] text-white sm:px-[42px] lg:py-[88px]">
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image:radial-gradient(ellipse 110% 120% at 100% 0%,rgba(139,24,88,0.9) 0%,rgba(139,24,88,0.55) 22%,rgba(139,24,88,0.22) 45%,rgba(139,24,88,0.06) 65%,rgba(139,24,88,0) 82%)"
    aria-hidden="true"
  />
  <div class="relative mx-auto max-w-[1356px]">
    <h2
      class="mx-auto mb-12 max-w-[1031px] text-center text-[clamp(2rem,3vw,2.625rem)] leading-[1.03] uppercase lg:mb-16"
      data-reveal="text"
    >
      {heading}
    </h2>

    {
      isAccordionLayout ? (
        <div data-process-cards data-reveal-group="100">
          {layout === 'accordionRow' && (
            <div class="mx-auto flex max-w-[1006px] flex-col gap-4 lg:flex-row lg:items-stretch">
              {steps[0] && (
                <ProcessCard
                  index={0}
                  title={steps[0].title}
                  description={steps[0].description}
                  tone={tones[0]}
                  expanded
                  class="min-h-[502px] lg:w-[441px] lg:shrink-0"
                />
              )}
              <div class="flex flex-1 flex-col gap-4 sm:flex-row">
                {steps.slice(1, 3).map((step, index) => (
                  <ProcessCard
                    index={index + 1}
                    title={step.title}
                    description={step.description}
                    tone={tones[index + 1]}
                    class="min-h-[243px] flex-1 lg:min-h-[502px]"
                  />
                ))}
              </div>
            </div>
          )}

          {layout === 'accordionColumns' && (
            <div class="mx-auto flex max-w-[1354px] flex-col gap-4 md:flex-row md:items-stretch">
              {steps[0] && (
                <ProcessCard
                  index={0}
                  title={steps[0].title}
                  description={steps[0].description}
                  tone={tones[0]}
                  expanded
                  class="min-h-[502px] flex-1"
                />
              )}
              <div class="flex flex-1 flex-col gap-4">
                {steps.slice(1, 3).map((step, index) => (
                  <ProcessCard
                    index={index + 1}
                    title={step.title}
                    description={step.description}
                    tone={tones[index + 1]}
                    class="min-h-[243px] flex-1"
                  />
                ))}
              </div>
              {steps[3] && (
                <ProcessCard
                  index={3}
                  title={steps[3].title}
                  description={steps[3].description}
                  tone={tones[3]}
                  class="min-h-[502px] flex-1"
                />
              )}
            </div>
          )}

          {layout === 'accordionSplit' && (
            <div class="mx-auto flex max-w-[1354px] flex-col gap-4 md:flex-row md:items-stretch">
              {steps[0] && (
                <ProcessCard
                  index={0}
                  title={steps[0].title}
                  description={steps[0].description}
                  tone={splitTones[0]}
                  expanded
                  class="min-h-[502px] flex-1"
                />
              )}
              <div class="flex flex-1 flex-col gap-4">
                {steps[1] && (
                  <ProcessCard
                    index={1}
                    title={steps[1].title}
                    description={steps[1].description}
                    tone={splitTones[1]}
                    class="min-h-[243px]"
                  />
                )}
                <div class="flex flex-1 flex-col gap-4 sm:flex-row">
                  {steps.slice(2, 4).map((step, index) => (
                    <ProcessCard
                      index={index + 2}
                      title={step.title}
                      description={step.description}
                      tone={splitTones[index + 2]}
                      class="min-h-[243px] flex-1"
                    />
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      ) : layout === 'dualPaths' ? (
        <div class="mx-auto flex max-w-[1356px] flex-col gap-4 md:flex-row md:items-stretch" data-reveal-group="100">
          {steps.slice(0, 2).map((step, index) => (
            <ProcessPathCard
              title={step.title}
              description={step.description}
              tone={pathTones[index]}
            />
          ))}
        </div>
      ) : layout === 'twoWide' ? (
        <div class="mx-auto grid max-w-[1354px] grid-cols-1 gap-4 lg:grid-cols-2" data-reveal-group="100">
          {steps.map((step, index) => (
            <article class="flex min-h-[502px] min-w-0 flex-col justify-end rounded-[4px] bg-[#150e0e] p-6">
              <div class="mb-auto flex items-start justify-between gap-4">
                <span class="font-display text-[clamp(1.75rem,2.5vw,2.25rem)] leading-none text-white/90">
                  {formatStep(index)}
                </span>
              </div>
              <div class="mt-6 flex flex-col gap-3">
                <h3 class="m-0 text-lg leading-[1.05]">{step.title}</h3>
                {step.description && (
                  <p class="m-0 text-base leading-[20px] text-white/75">{step.description}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : layout === 'threeMixed' ? (
        <div
          class="mx-auto grid max-w-[1354px] grid-cols-1 gap-4 md:grid-cols-3"
          data-reveal-group="100"
        >
          {steps[0] && (
            <article class="flex min-h-[502px] min-w-0 flex-col justify-end rounded-[4px] bg-[#150e0e] p-6 md:col-span-1">
              <span class="font-display text-[clamp(1.75rem,2.5vw,2.25rem)] leading-none text-white/90">
                {formatStep(0)}
              </span>
              <div class="mt-6 flex flex-col gap-3">
                <h3 class="m-0 text-lg leading-[1.05]">{steps[0].title}</h3>
                {steps[0].description && (
                  <p class="m-0 text-base leading-[20px] text-white/75">{steps[0].description}</p>
                )}
              </div>
            </article>
          )}
          <div class="flex flex-col gap-4">
            {steps.slice(1, 3).map((step, index) => (
              <article class="flex min-h-[243px] min-w-0 flex-col justify-end rounded-[4px] bg-[#150e0e] p-6">
                <span class="font-display text-[clamp(1.75rem,2.5vw,2.25rem)] leading-none text-white/90">
                  {formatStep(index + 1)}
                </span>
                <div class="mt-6 flex flex-col gap-3">
                  <h3 class="m-0 text-lg leading-[1.05]">{step.title}</h3>
                  {step.description && (
                    <p class="m-0 text-base leading-[20px] text-white/75">{step.description}</p>
                  )}
                </div>
              </article>
            ))}
          </div>
          {steps[3] && (
            <article class="flex min-h-[502px] min-w-0 flex-col justify-end rounded-[4px] bg-[#150e0e] p-6">
              <span class="font-display text-[clamp(1.75rem,2.5vw,2.25rem)] leading-none text-white/90">
                {formatStep(3)}
              </span>
              <div class="mt-6 flex flex-col gap-3">
                <h3 class="m-0 text-lg leading-[1.05]">{steps[3].title}</h3>
                {steps[3].description && (
                  <p class="m-0 text-base leading-[20px] text-white/75">{steps[3].description}</p>
                )}
              </div>
            </article>
          )}
        </div>
      ) : (
        <div
          class="mx-auto grid max-w-[1006px] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
          data-reveal-group="100"
        >
          {steps.map((step, index) => (
            <article class="flex min-h-[502px] min-w-0 flex-col justify-end rounded-[4px] bg-[#150e0e] p-6">
              <span class="font-display text-[clamp(1.75rem,2.5vw,2.25rem)] leading-none text-white/90">
                {formatStep(index)}
              </span>
              <div class="mt-6 flex flex-col gap-3">
                <h3 class="m-0 text-lg leading-[1.05]">{step.title}</h3>
                {step.description && (
                  <p class="m-0 text-base leading-[20px] text-white/75">{step.description}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

{
  isAccordionLayout && (
    <script>
      document.querySelectorAll<HTMLElement>('[data-process-cards]').forEach((root) => {
        const cards = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-process-card]'))

        const setExpanded = (active: HTMLButtonElement) => {
          cards.forEach((card) => {
            const isActive = card === active
            card.setAttribute('aria-expanded', String(isActive))

            const description = card.querySelector<HTMLElement>('[data-process-description]')
            if (description) {
              description.classList.toggle('grid-rows-[1fr]', isActive)
              description.classList.toggle('opacity-100', isActive)
              description.classList.toggle('grid-rows-[0fr]', !isActive)
              description.classList.toggle('opacity-0', !isActive)
            }

            card.querySelectorAll<HTMLImageElement>('[data-process-icon="plus"]').forEach((icon) => {
              icon.classList.toggle('opacity-100', !isActive)
              icon.classList.toggle('opacity-0', isActive)
            })
            card.querySelectorAll<HTMLImageElement>('[data-process-icon="minus"]').forEach((icon) => {
              icon.classList.toggle('opacity-100', isActive)
              icon.classList.toggle('opacity-0', !isActive)
            })

            const tone = card.dataset.tone
            const decorSrc = '/assets/figma/services/process/card-decor.svg'
            let decor = card.querySelector<HTMLImageElement>('[data-process-decor]')

            if (isActive && tone === 'teal') {
              card.classList.add('border-2', 'border-[#447a82]')
              if (!decor) {
                decor = document.createElement('img')
                decor.src = decorSrc
                decor.alt = ''
                decor.setAttribute('data-process-decor', '')
                decor.className =
                  'pointer-events-none absolute inset-0 h-full w-full rounded-[2px] object-cover mix-blend-luminosity'
                decor.setAttribute('aria-hidden', 'true')
                card.insertBefore(decor, card.firstChild)
              }
            } else {
              card.classList.remove('border-2', 'border-[#447a82]')
              decor?.remove()
            }
          })
        }

        cards.forEach((card) => {
          card.addEventListener('click', () => {
            if (card.getAttribute('aria-expanded') === 'true') return
            setExpanded(card)
          })
        })
      })
    </script>
  )
}
