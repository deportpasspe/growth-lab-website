---
export type ProcessPathCardTone = 'teal' | 'magenta'

interface Props {
  title: string
  description?: string
  tone: ProcessPathCardTone
  class?: string
}

const {title, description, tone, class: className} = Astro.props

const toneStyles: Record<
  ProcessPathCardTone,
  {bg: string; text: string; icon: string; decor: string}
> = {
  teal: {
    bg: 'bg-[#054e58]',
    text: 'text-white',
    icon: '/assets/figma/services/process/path-icon-teal.svg',
    decor: '/assets/figma/services/process/path-decor-teal.svg',
  },
  magenta: {
    bg: 'bg-[#8b1758]',
    text: 'text-white',
    icon: '/assets/figma/services/process/path-icon-magenta.svg',
    decor: '/assets/figma/services/process/path-decor-magenta.svg',
  },
}

const styles = toneStyles[tone]
---

<article
  class:list={[
    'relative flex min-h-[400px] min-w-0 flex-1 flex-col gap-4 overflow-hidden rounded-[2px] p-8',
    styles.bg,
    styles.text,
    className,
  ]}
>
  <img
    src={styles.decor}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover mix-blend-luminosity"
    aria-hidden="true"
  />
  <img
    src={styles.icon}
    alt=""
    width="54"
    height="54"
    class="relative z-[1] h-[54px] w-[54px] shrink-0"
  />
  <div class="relative z-[1] flex flex-col gap-4">
    <h3 class="m-0 text-2xl leading-normal">{title}</h3>
    {description && <p class="m-0 text-base leading-[22px]">{description}</p>}
  </div>
</article>
