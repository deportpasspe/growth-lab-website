---
import type {Locale} from '../../i18n/routes'
import {t} from '../../i18n'
import {contactChannels} from '../contactPageFixtures'
import type {ContactChannel} from '../../lib/sanity/types'
import {urlFor} from '../../lib/sanity/image'
import type {SanityImageSource} from '@sanity/image-url'

interface Props {
  locale: Locale
  heading?: string
  channels?: ContactChannel[]
}

const {locale, heading, channels: cmsChannels} = Astro.props
const channels = cmsChannels?.length ? cmsChannels : contactChannels(locale)
const sectionHeading = heading || t(locale, 'contact.channelsHeading')

function channelIconSrc(icon: ContactChannel['icon']): string {
  if (!icon) return ''
  if (typeof icon === 'string') return icon
  return urlFor(icon as SanityImageSource).width(54).height(54).fit('max').auto('format').url()
}
---

<section class="bg-black px-6 py-16 text-white sm:px-[42px] sm:py-[72px]">
  <div class="mx-auto max-w-[1356px]" data-reveal-group="100">
    <h2 class="m-0 max-w-[546px] text-[clamp(1.25rem,2vw,1.625rem)] leading-normal" data-reveal="text">
      {sectionHeading}
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        channels.map((channel) => (
          <article
            class="flex min-h-[225px] flex-col justify-center gap-6 rounded-[4px] border border-magenta px-4 py-6"
            data-reveal
          >
            <img src={channelIconSrc(channel.icon)} alt="" class="size-[54px] max-w-none" width="54" height="54" />
            <div class="flex flex-col gap-2.5">
              <p class="m-0 text-[22px] leading-normal">{channel.title}</p>
              {
                channel.href ? (
                  <a href={channel.href} class="m-0 text-base leading-normal text-white/90 no-underline hover:underline">
                    {channel.value}
                  </a>
                ) : (
                  <p class="m-0 text-base leading-normal text-white/90">{channel.value}</p>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
