---
import type {Locale} from '../../i18n/routes'
import {t} from '../../i18n'
import {contactChannels} from '../contactPageFixtures'

interface Props {
  locale: Locale
}

const {locale} = Astro.props
const channels = contactChannels(locale)
---

<section class="bg-black px-6 py-16 text-white sm:px-[42px] sm:py-[72px]">
  <div class="mx-auto max-w-[1356px]" data-reveal-group="100">
    <h2 class="m-0 max-w-[546px] text-[clamp(1.25rem,2vw,1.625rem)] leading-normal" data-reveal="text">
      {t(locale, 'contact.channelsHeading')}
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        channels.map((channel) => (
          <article
            class="flex min-h-[225px] flex-col justify-center gap-6 rounded-[4px] border border-magenta px-4 py-6"
            data-reveal
          >
            <img src={channel.icon} alt="" class="size-[54px] max-w-none" width="54" height="54" />
            <div class="flex flex-col gap-2.5">
              <p class="m-0 text-[22px] leading-normal">{channel.title}</p>
              {
                channel.href ? (
                  <a href={channel.href} class="m-0 text-base leading-normal text-white/90 no-underline hover:underline">
                    {channel.value}
                  </a>
                ) : (
                  <p class="m-0 text-base leading-normal text-white/90">{channel.value}</p>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
