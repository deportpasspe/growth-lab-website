---
import {actions} from 'astro:actions'
import type {Locale} from '../../i18n/routes'
import {t} from '../../i18n'
import {formErrorClass, formHeadingClass} from '../../lib/forms'
import Button from '../../components/ui/Button.astro'
import FormCheckbox from '../../components/ui/FormCheckbox.astro'
import FormField from '../../components/ui/FormField.astro'
import FormInput from '../../components/ui/FormInput.astro'
import FormSelect from '../../components/ui/FormSelect.astro'

interface Props {
  locale: Locale
  title?: string
  interestOptions: {value: string; label: string}[]
}

const {locale, title = t(locale, 'contact.pathsFormHeading'), interestOptions} = Astro.props
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined
const result = Astro.getActionResult(actions.contact)
---

<form method="POST" action={actions.contact} data-contact-form class="grid gap-4">
  <input type="hidden" name="locale" value={locale} />

  <label class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    {t(locale, 'form.honeypot')}
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>

  <p class={formHeadingClass('dark', 'text-2xl leading-normal')}>{title}</p>

  <FormField tone="dark" label={t(locale, 'form.name')}>
    <FormInput
      tone="dark"
      required
      name="name"
      type="text"
      autocomplete="name"
      placeholder={t(locale, 'form.name')}
    />
  </FormField>

  <FormField tone="dark" label={t(locale, 'form.email')}>
    <FormInput
      tone="dark"
      required
      name="email"
      type="email"
      autocomplete="email"
      placeholder={t(locale, 'form.email')}
    />
  </FormField>

  <FormField tone="dark" label={t(locale, 'form.company')}>
    <FormInput
      tone="dark"
      name="company"
      type="text"
      autocomplete="organization"
      placeholder={t(locale, 'form.company')}
    />
  </FormField>

  <FormField tone="dark" label={t(locale, 'contact.form.role')}>
    <FormInput
      tone="dark"
      name="role"
      type="text"
      autocomplete="organization-title"
      placeholder={t(locale, 'contact.form.rolePlaceholder')}
    />
  </FormField>

  <FormField tone="dark" label={t(locale, 'contact.form.interest')}>
    <FormSelect name="interestArea" aria-label={t(locale, 'contact.form.interest')}>
      <option value="">{t(locale, 'contact.form.interestPlaceholder')}</option>
      {interestOptions.map((option) => (
        <option value={option.label}>{option.label}</option>
      ))}
    </FormSelect>
  </FormField>

  <FormField tone="dark" label={t(locale, 'contact.form.challenge')}>
    <FormInput
      tone="dark"
      required
      name="message"
      type="text"
      placeholder={t(locale, 'contact.form.challengePlaceholder')}
    />
  </FormField>

  <FormCheckbox tone="dark" required class="text-white/75">
    {t(locale, 'contact.form.consent')}
  </FormCheckbox>

  {
    turnstileSiteKey && (
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />
    )
  }

  {
    result?.error && (
      <p class={formErrorClass('dark')} role="alert">
        {result.error.message || t(locale, 'errors.generic')}
      </p>
    )
  }

  <Button type="submit" variant="primary" size="md" class="w-[100px]">
    {t(locale, 'contact.form.submit')}
  </Button>
</form>

{
  turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}
