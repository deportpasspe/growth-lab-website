---
import Button from '../../components/ui/Button.astro'
import {resolveHeroImage} from '../../lib/images'
import type {SanityImageSource} from '@sanity/image-url'

interface Props {
  variant?: 'home' | 'recruitment' | 'services' | 'servicePage' | 'about' | 'methodology' | 'insights' | 'caseStudies' | 'caseStudyDetail' | 'contact'
  eyebrow?: string
  heading: string
  subheading?: string
  pill?: string
  image?: string | SanityImageSource
  primaryCta?: {label: string; href: string}
  secondaryCta?: {label: string; href: string}
}

const {
  variant = 'home',
  eyebrow,
  heading,
  subheading,
  pill,
  image,
  primaryCta,
  secondaryCta,
} = Astro.props

const isCompactHero =
  variant === 'insights' ||
  variant === 'caseStudies' ||
  variant === 'caseStudyDetail' ||
  variant === 'contact'

const homeHeroHeight = 'min-h-[720px] lg:h-[810px]'
const heroContentShell = [
  'relative z-10 mx-auto w-full px-6 sm:px-[42px]',
  homeHeroHeight,
  variant === 'servicePage'
    ? 'flex flex-col justify-end pb-16 pt-40 lg:justify-center lg:pb-16 lg:pt-28'
    : 'flex flex-col justify-end pb-16 pt-40 lg:min-h-0 lg:h-full lg:block lg:pt-0',
]
const heroStackDesktop =
  'justify-center pb-12 pt-28 lg:absolute lg:left-[42px] lg:top-1/2 lg:min-h-0 lg:-translate-y-1/2 lg:justify-start lg:pb-0 lg:pt-0'
const heroStackClass = 'hero-stack flex w-full flex-col'
const heroEyebrowClass = 'hero-stack__eyebrow m-0 text-2xl leading-[1.15] text-white'
const heroHeadingClass =
  'hero-stack__heading m-0 font-display uppercase leading-[1.08]'
const heroSubheadingClass = 'hero-stack__subheading m-0 text-lg leading-[1.35] text-white'
const heroActionsClass = 'hero-stack__actions flex flex-wrap gap-4'

const heroFallback =
  variant === 'recruitment'
    ? '/assets/figma/recruitment/hero.webp'
    : variant === 'services' || variant === 'servicePage'
      ? '/assets/figma/services/hero.webp'
      : variant === 'about'
        ? '/assets/figma/about/hero.webp'
        : variant === 'methodology'
          ? '/assets/figma/methodology/hero.webp'
          : variant === 'insights'
            ? '/assets/figma/insights/hero.webp'
            : variant === 'caseStudies'
              ? '/assets/figma/case-studies/hero.webp'
              : variant === 'caseStudyDetail'
                ? '/assets/figma/case-studies/detail-hero.webp'
                : variant === 'contact'
                  ? '/assets/figma/contact/hero.webp'
                  : '/assets/figma/home/hero.webp'

const heroImage = resolveHeroImage(image, heroFallback)

const parallaxSpeed =
  variant === 'recruitment' || variant === 'about' || variant === 'methodology'
    ? '0.06'
    : variant === 'services' || variant === 'servicePage' || isCompactHero
      ? '0.05'
      : '0.14'

const heroBgObjectPosition = variant === 'recruitment' || variant === 'home' ? 'bottom' : 'center'

const hasParallaxOverscan =
  variant === 'recruitment' ||
  variant === 'about' ||
  variant === 'methodology' ||
  variant === 'home' ||
  variant === 'services' ||
  variant === 'servicePage' ||
  isCompactHero

const heroBgOverscanClass = !hasParallaxOverscan
  ? undefined
  : variant === 'home'
    ? 'hero-bg__image--overscan-tall'
    : 'hero-bg__image--overscan'
---

<section
  class:list={['relative isolate overflow-hidden bg-black text-white', homeHeroHeight]}
>
  <div class="hero-bg absolute inset-0 overflow-hidden" aria-hidden="true" data-parallax={parallaxSpeed}>
    <img
      src={heroImage.src}
      {...heroImage.srcset ? {srcset: heroImage.srcset, sizes: '(max-width: 640px) 100vw, 1024px'} : {}}
      alt=""
      class:list={[
        'hero-bg__image',
        heroBgObjectPosition === 'bottom' && 'hero-bg__image--bottom',
        heroBgOverscanClass,
      ]}
      width={heroImage.width}
      height={heroImage.height}
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="pointer-events-none absolute inset-0 bg-black/50" aria-hidden="true"></div>
  <div class="hero-overlay pointer-events-none absolute inset-0" aria-hidden="true"></div>
  {
    variant === 'home' && (
      <img
        src="/assets/figma/home/hero-accent.svg"
        alt=""
        class="pointer-events-none absolute -left-[195px] -top-[235px] h-[783px] w-[779px] max-w-none opacity-70"
        width="779"
        height="783"
        data-parallax="-0.22"
      />
    )
  }

  <div class:list={heroContentShell}>
    {
      variant === 'services' ? (
        <div
          class:list={[heroStackClass, heroStackDesktop, 'max-w-[648px]']}
          data-reveal-group="140"
          data-reveal-on="load"
        >
          <h1
            class:list={[heroHeadingClass, 'max-w-[648px] text-[clamp(2rem,4.25vw,3.25rem)]']}
            data-reveal
          >
            {heading}
          </h1>
          {subheading && (
            <p class:list={[heroSubheadingClass, 'max-w-[529px]']} data-reveal>
              {subheading}
            </p>
          )}
        </div>
      ) : variant === 'servicePage' ? (
        <div
          class:list={[heroStackClass, 'max-w-[848px]']}
          data-reveal-group="140"
          data-reveal-on="load"
        >
          {eyebrow && (
            <p class={heroEyebrowClass} data-reveal>
              {eyebrow}
            </p>
          )}
          <h1
            class:list={[heroHeadingClass, 'max-w-[848px] text-[clamp(2rem,4.25vw,3.25rem)]']}
            data-reveal
          >
            {heading}
          </h1>
          {subheading && (
            <p class:list={[heroSubheadingClass, 'max-w-[672px]']} data-reveal>
              {subheading}
            </p>
          )}
          {(primaryCta || secondaryCta) && (
            <div class={heroActionsClass} data-reveal>
              {primaryCta && (
                <Button href={primaryCta.href} variant="secondary" size="lg">
                  {primaryCta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button href={secondaryCta.href} variant="primary" size="lg">
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )}
        </div>
      ) : variant === 'insights' || variant === 'caseStudies' ? (
        <div
          class:list={[heroStackClass, heroStackDesktop, 'max-w-[848px]']}
          data-reveal-group="140"
          data-reveal-on="load"
        >
          {eyebrow && (
            <p class={heroEyebrowClass} data-reveal>
              {eyebrow}
            </p>
          )}
          <h1
            class:list={[heroHeadingClass, 'max-w-[848px] text-[clamp(2rem,4.25vw,3.25rem)]']}
            data-reveal
          >
            {heading}
          </h1>
          {subheading && (
            <p class:list={[heroSubheadingClass, 'max-w-[672px]']} data-reveal>
              {subheading}
            </p>
          )}
        </div>
      ) : variant === 'caseStudyDetail' ? (
        <div
          class:list={[heroStackClass, heroStackDesktop, 'max-w-[634px]']}
          data-reveal-group="140"
          data-reveal-on="load"
        >
          {pill && (
            <span class="hero-stack__pill inline-flex h-6 items-center rounded-full bg-[#d0dadd] px-3.5 text-sm leading-none text-black" data-reveal>
              {pill}
            </span>
          )}
          {subheading && (
            <p class:list={[heroSubheadingClass, 'max-w-[634px]']} data-reveal>
              {subheading}
            </p>
          )}
          <h1
            class:list={[heroHeadingClass, 'max-w-[634px] text-[clamp(2rem,4.25vw,3.25rem)]']}
            data-reveal
          >
            {heading}
          </h1>
        </div>
      ) : variant === 'contact' ? (
        <div
          class:list={[heroStackClass, heroStackDesktop, 'max-w-[683px]']}
          data-reveal-group="140"
          data-reveal-on="load"
        >
          <h1
            class:list={[heroHeadingClass, 'max-w-[683px] text-[clamp(2rem,3.6vw,3.25rem)]']}
            data-reveal
          >
            {heading}
          </h1>
          {subheading && (
            <p class:list={[heroSubheadingClass, 'max-w-[445px]']} data-reveal>
              {subheading}
            </p>
          )}
        </div>
      ) : variant === 'about' ? (
        <div
          class:list={[heroStackClass, heroStackDesktop, 'max-w-[683px]']}
          data-reveal-group="140"
          data-reveal-on="load"
        >
          {eyebrow && (
            <p class={heroEyebrowClass} data-reveal>
              {eyebrow}
            </p>
          )}
          <h1
            class:list={[heroHeadingClass, 'max-w-[589px] text-[clamp(2rem,3.6vw,3.25rem)]']}
            data-reveal
          >
            {heading}
          </h1>
          {subheading && (
            <p class:list={[heroSubheadingClass, 'max-w-[551px]']} data-reveal>
              {subheading}
            </p>
          )}
        </div>
      ) : variant === 'methodology' ? (
        <div
          class:list={[heroStackClass, heroStackDesktop, 'max-w-[607px]']}
          data-reveal-group="140"
          data-reveal-on="load"
        >
          {eyebrow && (
            <p class={heroEyebrowClass} data-reveal>
              {eyebrow}
            </p>
          )}
          <h1
            class:list={[heroHeadingClass, 'max-w-[607px] text-[clamp(2rem,3.6vw,3.25rem)]']}
            data-reveal
          >
            {heading}
          </h1>
          {subheading && (
            <p class:list={[heroSubheadingClass, 'max-w-[607px]']} data-reveal>
              {subheading}
            </p>
          )}
        </div>
      ) : variant === 'recruitment' ? (
        <div
          class:list={[heroStackClass, heroStackDesktop, 'max-w-[670px]']}
          data-reveal-group="140"
          data-reveal-on="load"
        >
          {eyebrow && (
            <p class={heroEyebrowClass} data-reveal>
              {eyebrow}
            </p>
          )}
          <h1
            class:list={[heroHeadingClass, 'max-w-[670px] text-[clamp(2rem,4.25vw,3.25rem)]']}
            data-reveal
          >
            {heading}
          </h1>
          {subheading && (
            <p class:list={[heroSubheadingClass, 'max-w-[529px]']} data-reveal>
              {subheading}
            </p>
          )}
          {(primaryCta || secondaryCta) && (
            <div class={heroActionsClass} data-reveal>
              {primaryCta && (
                <Button href={primaryCta.href} variant="secondary" size="lg">
                  {primaryCta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button href={secondaryCta.href} variant="primary" size="lg">
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )}
        </div>
      ) : (
        <div class="hero-stack hero-stack--home flex flex-col gap-12 lg:block" data-reveal-group="140" data-reveal-on="load">
          <div class="lg:absolute lg:left-[42px] lg:top-[369px] lg:w-[523px]">
            {eyebrow && (
              <p class="hero-stack__eyebrow mb-5 text-sm uppercase tracking-widest text-white/70" data-reveal>
                {eyebrow}
              </p>
            )}
            <h1
              class:list={[heroHeadingClass, 'max-w-[523px] text-[clamp(2.5rem,3.62vw,3.25rem)] leading-[1.04]']}
              data-reveal
            >
              {heading}
            </h1>
          </div>

          {subheading && (
            <p
              class="hero-stack__subheading m-0 max-w-[302px] text-base leading-[1.35] lg:absolute lg:right-[42px] lg:top-[451px] lg:text-lg"
              data-reveal
            >
              {subheading}
            </p>
          )}

          {(primaryCta || secondaryCta) && (
            <div class="hero-stack__actions flex flex-wrap gap-4 lg:absolute lg:left-[42px] lg:top-[595px]" data-reveal>
              {primaryCta && (
                <Button href={primaryCta.href} variant="primary" size="lg">
                  {primaryCta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button href={secondaryCta.href} variant="secondary" size="lg">
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero-overlay {
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.52) 0%,
      rgb(0 0 0 / 0.36) 24%,
      rgb(0 0 0 / 0.2) 50%,
      rgb(0 0 0 / 0.08) 76%,
      rgb(0 0 0 / 0) 100%
    );
  }

  @keyframes hero-bg-zoom {
    from {
      transform: scale(1.04);
    }
    to {
      transform: scale(1);
    }
  }

  .hero-stack > * + * {
    margin-top: 1.75rem;
  }

  .hero-stack__eyebrow + .hero-stack__heading,
  .hero-stack__pill + .hero-stack__subheading,
  .hero-stack__pill + .hero-stack__heading {
    margin-top: 1.1875rem;
  }

  .hero-stack__heading + .hero-stack__subheading {
    margin-top: 1.75rem;
  }

  .hero-stack__subheading + .hero-stack__heading {
    margin-top: 1.75rem;
  }

  .hero-stack__subheading + .hero-stack__actions,
  .hero-stack__heading + .hero-stack__actions {
    margin-top: 2.25rem;
  }

  .hero-stack--home > * + * {
    margin-top: 0;
  }

  .hero-bg__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-bg__image {
      animation: hero-bg-zoom 2.4s var(--ease-out) both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg__image {
      animation: none;
    }
  }

  .hero-bg__image--bottom {
    object-position: bottom;
  }

  .hero-bg__image--overscan {
    top: -2.5%;
    height: 105%;
  }

  .hero-bg__image--overscan-tall {
    top: -6%;
    height: 112%;
  }
</style>
