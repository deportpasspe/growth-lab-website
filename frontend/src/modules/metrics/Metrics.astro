---
import StatIcon from '../../components/ui/StatIcon.astro'

interface Metric {
  value: string
  label: string
  icon?: 'calendar' | 'process' | 'cost'
}

interface Props {
  title?: string
  columns?: 3 | 4
  alignTitle?: 'center' | 'left'
  compact?: boolean
  items: Metric[]
}

const {title, columns = 3, alignTitle = 'center', compact: compactProp, items} = Astro.props
const compact = compactProp ?? columns === 4
const cardHeightClass = compact ? 'min-h-[366px]' : 'min-h-[320px] md:min-h-[364px]'

function splitMetricValue(value: string): {count: string; unit?: string} {
  const normalized = value.replace(/\u2212/g, '−').trim()
  const match = normalized.match(/^([+\-−]?\s*[\d]+(?:[.,]\d+)?)([\s\S]*)$/u)
  if (!match) return {count: value}

  const count = match[1].replace(/\s/g, '')
  const rawUnit = match[2].trim()
  if (!rawUnit) return {count}

  // Keep compact suffixes like "/10" with the number.
  if (rawUnit.startsWith('/') || rawUnit.length <= 2) {
    return {count: `${count}${rawUnit}`}
  }

  return {count, unit: rawUnit}
}
---

<section class="bg-black px-6 pb-[62px] pt-8 text-white sm:px-[42px]">
  {
    title && (
      <h2
        class:list={[
          'mx-auto mb-10 mt-0 text-2xl leading-none text-white',
          alignTitle === 'left' ? 'max-w-[1356px] text-left' : 'max-w-[478px] text-center',
        ]}
        data-reveal="text"
      >
        {title}
      </h2>
    )
  }
  <div
    class:list={[
      'mx-auto grid max-w-[1356px] items-stretch gap-4',
      columns === 4 ? 'sm:grid-cols-2 xl:grid-cols-4' : 'md:grid-cols-3',
    ]}
    data-reveal-group="120"
  >
    {
      items.map((item) => {
        const {count, unit} = splitMetricValue(item.value)
        return (
          <article
            class:list={[
              'flex h-full min-w-0 flex-col overflow-hidden bg-[#150e0e] p-[42px]',
              compact ? 'min-h-[366px]' : cardHeightClass,
            ]}
            data-reveal
            data-metric
          >
            <div class="flex min-h-0 flex-1 flex-col gap-4">
              {item.icon && <StatIcon icon={item.icon} />}
              <div class="mt-auto min-w-0">
                <p
                  class:list={[
                    'm-0 min-w-0 font-display leading-none uppercase tabular-nums',
                    compact
                      ? 'text-[clamp(2.25rem,2.6vw,2.75rem)]'
                      : 'text-[clamp(2.75rem,3.9vw,3.5rem)] md:text-[3.5rem]',
                  ]}
                  data-count-value={count}
                >
                  {count}
                </p>
                <p
                  class:list={[
                    'm-0 mt-1.5 min-h-[1.25rem] text-sm leading-tight text-white/70 md:min-h-[1.5rem] md:text-base',
                    !unit && 'invisible',
                  ]}
                  aria-hidden={!unit}
                >
                  {unit || '\u00a0'}
                </p>
              </div>
            </div>
            <p
              class:list={[
                'm-0 border-t border-white/50 pt-4 text-base leading-snug md:text-lg',
                compact ? 'min-h-[6.75rem]' : 'min-h-[5rem]',
              ]}
            >
              {item.label}
            </p>
          </article>
        )
      })
    }
  </div>
</section>
