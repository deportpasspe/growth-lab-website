---
import {actions} from 'astro:actions'
import type {Locale} from '../../i18n/routes'
import {getLocalizedPath} from '../../i18n/routes'
import {t} from '../../i18n'
import Container from '../../components/ui/Container.astro'
import Section from '../../components/ui/Section.astro'
import Heading from '../../components/ui/Heading.astro'
import Button from '../../components/ui/Button.astro'
import TextLink from '../../components/ui/TextLink.astro'
import FormCheckbox from '../../components/ui/FormCheckbox.astro'
import FormField from '../../components/ui/FormField.astro'
import FormInput from '../../components/ui/FormInput.astro'
import FormTextarea from '../../components/ui/FormTextarea.astro'
import {formErrorClass} from '../../lib/forms'

interface Props {
  locale: Locale
  title?: string
  intro?: string
}

const {locale, title, intro} = Astro.props
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined
const privacyHref = getLocalizedPath(locale, 'privacy')
const result = Astro.getActionResult(actions.contact)

if (result && !result.error && result.data?.ok) {
  return Astro.redirect(getLocalizedPath(locale, 'thankYou'))
}
---

<Section id="contacto">
  <Container narrow>
    <div data-reveal-group="110">
      {
        title && (
          <div data-reveal="text">
            <Heading as="h2">{title}</Heading>
          </div>
        )
      }
      {
        intro && (
          <p class="mt-4 text-white/75" data-reveal>
            {intro}
          </p>
        )
      }
    </div>

    <form
      method="POST"
      action={actions.contact}
      data-contact-form
      class="mt-10 grid gap-5"
      data-reveal
    >
      <input type="hidden" name="locale" value={locale} />

      <label class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
        {t(locale, 'form.honeypot')}
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>

      <FormField tone="dark" label={t(locale, 'form.name')}>
        <FormInput tone="dark" required name="name" type="text" autocomplete="name" />
      </FormField>

      <FormField tone="dark" label={t(locale, 'form.email')}>
        <FormInput tone="dark" required name="email" type="email" autocomplete="email" />
      </FormField>

      <div class="grid gap-5 sm:grid-cols-2">
        <FormField tone="dark" label={t(locale, 'form.company')}>
          <FormInput tone="dark" name="company" type="text" autocomplete="organization" />
        </FormField>
        <FormField tone="dark" label={t(locale, 'form.phone')}>
          <FormInput tone="dark" name="phone" type="tel" autocomplete="tel" />
        </FormField>
      </div>

      <FormField tone="dark" label={t(locale, 'form.message')}>
        <FormTextarea tone="dark" required name="message" rows={5} />
      </FormField>

      <FormCheckbox tone="dark" required>
        {t(locale, 'form.privacy')} —
        <TextLink href={privacyHref}>{t(locale, 'footer.privacy')}</TextLink>
      </FormCheckbox>

      {
        turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />
        )
      }

      {
        result?.error && (
          <p class={formErrorClass('dark')} data-form-error role="alert">
            {result.error.message || t(locale, 'errors.generic')}
          </p>
        )
      }

      <Button type="submit" variant="brand">
        {t(locale, 'cta.submit')}
      </Button>
    </form>
  </Container>
</Section>

{
  turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}
