---
export type ServiceIncludesAccent = 'teal' | 'magenta'

interface Props {
  heading: string
  items: string[]
  accent: ServiceIncludesAccent
  class?: string
}

const {heading, items, accent, class: className} = Astro.props

const accentStyles: Record<ServiceIncludesAccent, {border: string; checkIcon: string}> = {
  teal: {
    border: 'border-[#054e58]',
    checkIcon: '/assets/figma/services/includes/check-teal.svg',
  },
  magenta: {
    border: 'border-[#8b1758]',
    checkIcon: '/assets/figma/services/includes/check-magenta.svg',
  },
}

const styles = accentStyles[accent]
---

<article
  class:list={[
    'flex flex-col justify-center overflow-hidden rounded-[2px] border-l-4 p-6',
    styles.border,
    className,
  ]}
>
  <div class="flex flex-col gap-8">
    <h2 class="m-0 text-2xl uppercase leading-normal">{heading}</h2>
    <ul class="mb-0 list-none space-y-1 p-0">
      {
        items.map((item) => (
          <li class="flex items-center gap-2.5 text-base leading-[22px] text-white/75">
            <img
              src={styles.checkIcon}
              alt=""
              class="h-[9.5px] w-3.5 max-w-none shrink-0"
              width="14"
              height="10"
            />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</article>
