---
import type { Locale } from "../i18n/routes";
import type { PortableTextBlock } from "@portabletext/types";
import { PortableText } from "astro-portabletext";
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Heading from "../components/ui/Heading.astro";
import { loadQuery } from "../lib/sanity/loadQuery";
import { legalPageBySlugQuery } from "../lib/sanity/queries/pages";
import { t } from "../i18n";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;

const privacySlug = locale === "es" ? "politica-de-privacidad" : "privacy-policy";
const resolvedSlug = slug || privacySlug;

let title = t(locale, "footer.privacy");
let description =
  locale === "es"
    ? "Esta es una página legal placeholder. El contenido completo se gestiona en Sanity."
    : "This is a legal page placeholder. Full content is managed in Sanity.";
let body: PortableTextBlock[] | null = null;

try {
  const data = await loadQuery<{
    title?: string;
    body?: PortableTextBlock[];
    seo?: { metaTitle?: string; metaDescription?: string };
  } | null>(legalPageBySlugQuery, { locale, slug: resolvedSlug });
  if (data) {
    title = data.seo?.metaTitle || data.title || title;
    description = data.seo?.metaDescription || description;
    body = data.body || null;
  }
} catch {
  // placeholder
}
---

<Layout locale={locale} title={title} description={description}>
  <Section>
    <Container narrow>
      <Heading as="h1">{title}</Heading>
      {
        Array.isArray(body) && body.length > 0 ? (
          <div class="prose prose-neutral mt-8 max-w-none">
            <PortableText value={body} />
          </div>
        ) : (
          <p class="mt-6 text-navy-muted">{description}</p>
        )
      }
    </Container>
  </Section>
</Layout>
