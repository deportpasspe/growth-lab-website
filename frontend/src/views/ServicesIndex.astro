---
import type {Locale} from '../i18n/routes'
import Layout from '../layouts/Layout.astro'
import PageBuilder from '../components/PageBuilder.astro'
import {servicesFixtures, type PageSection} from '../modules/fixtures'
import {loadQuery} from '../lib/sanity/loadQuery'
import {servicesIndexPageQuery} from '../lib/sanity/queries/pages'
import {resolvePageSeo, type PageSeo} from '../lib/seo/resolvePageSeo'
import {singletonBreadcrumbs} from '../lib/seo/breadcrumbs'

interface Props {
  locale: Locale
}

const {locale} = Astro.props
const perspectiveCookie = Astro.locals.perspectiveCookie

let sections: PageSection[] = servicesFixtures(locale)
let title = locale === 'es' ? 'Servicios' : 'Services'
let description =
  locale === 'es'
    ? 'Reclutamiento ejecutivo y desarrollo organizacional con criterio.'
    : 'Executive search and organizational development with judgment.'

let seo: PageSeo | undefined

try {
  const data = await loadQuery<{
    title?: string
    intro?: string
    seo?: PageSeo
    pageBuilder?: PageSection[]
  } | null>(servicesIndexPageQuery, {locale}, {perspectiveCookie})

  if (data?.pageBuilder?.length) {
    sections = data.pageBuilder
    seo = data.seo
    title = data.seo?.metaTitle || data.title || title
    description = data.seo?.metaDescription || data.intro || description
  } else if (data) {
    seo = data.seo
    title = data.seo?.metaTitle || data.title || title
    description = data.seo?.metaDescription || data.intro || description
  }
} catch {
  // CMS unavailable — fixtures
}

const heroImage = sections.find((section) => section._type === 'hero')?.image
const meta = resolvePageSeo({
  seo,
  title,
  description,
  ogImageFallback: heroImage,
  origin: Astro.url.origin,
})
---

<Layout
  locale={locale}
  title={meta.title}
  description={meta.description}
  image={meta.image}
  headerAppearance="overlay"
  routeKey="services"
  breadcrumbs={singletonBreadcrumbs(locale, meta.title, Astro.url.pathname)}
>
  <PageBuilder locale={locale} sections={sections} />
</Layout>
