---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
---

<Layout locale="es" title="Página no encontrada" noindex>
  <Section>
    <Container class="max-w-xl text-center">
      <div data-reveal-group="120">
        <h1 class="font-display text-[length:var(--text-display)] leading-[var(--leading-tight)] tracking-[var(--tracking-display)]" data-reveal="text">404</h1>
        <p class="mt-4 text-white/75" data-reveal>No encontramos esta página.</p>
        <div class="mt-8" data-reveal>
          <Button href="/es/">Volver al inicio</Button>
        </div>
      </div>
    </Container>
  </Section>
</Layout>
