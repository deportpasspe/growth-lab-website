---
import type {Locale} from '../../i18n/routes'
import {getLocalizedPath} from '../../i18n/routes'
import {t} from '../../i18n'
import Heading from '../ui/Heading.astro'
import TextLink from '../ui/TextLink.astro'

interface Props {
  locale: Locale
  title: string
  summary?: string
  slug: string
}

const {locale, title, summary, slug} = Astro.props
---

<article class="group border-t border-border pt-6">
  <Heading as="h3" size="h3">{title}</Heading>
  {summary && <p class="mt-3 text-navy-muted">{summary}</p>}
  <TextLink
    href={getLocalizedPath(locale, 'service', slug)}
    class="mt-4 inline-flex text-sm"
  >
    {t(locale, 'cta.learnMore')}
  </TextLink>
</article>
