---
import type {Locale} from '../../i18n/routes'
import {getLocalizedPath} from '../../i18n/routes'
import type {SanityImageSource} from '@sanity/image-url'
import {t} from '../../i18n'
import {
  caseStudyCoverUrl,
  caseStudyGridImage,
  caseStudyRelatedTitle,
} from '../../lib/caseStudies'

interface Props {
  locale: Locale
  title: string
  slug: string
  industry?: string
  challenge?: string
  cover?: string | SanityImageSource
  imageIndex?: number
  class?: string
}

const {
  locale,
  title,
  slug,
  industry,
  challenge,
  cover,
  imageIndex = 0,
  class: className,
} = Astro.props

const headline = caseStudyRelatedTitle({challenge, title})
const href = getLocalizedPath(locale, 'caseStudy', slug)
const gridImage = caseStudyGridImage(imageIndex)
const imageSrc = cover ? caseStudyCoverUrl(cover) : gridImage.src
---

<a
  href={href}
  class:list={[
    'group flex min-h-[482px] flex-col overflow-hidden rounded-[4px] bg-[#150e0e] no-underline transition-[transform,box-shadow] duration-300 ease-[var(--ease-out)] hover:-translate-y-1 hover:shadow-[0_16px_34px_rgba(139,24,88,0.2)]',
    className,
  ]}
>
  <div class="relative min-h-[280px] flex-1 overflow-hidden p-3">
    <img
      src={imageSrc}
      alt=""
      class="absolute inset-0 !h-full !w-full rounded-[4px] object-cover transition-[scale] duration-500 ease-[var(--ease-out)] group-hover:scale-[1.025]"
      width="671"
      height="280"
    />
    {
      industry && (
        <span class="relative inline-flex h-6 items-center rounded-full bg-[#d0dadd] px-3.5 text-sm leading-none text-black">
          {industry}
        </span>
      )
    }
  </div>
  <div class="flex flex-col gap-2.5 p-[42px]">
    <h3 class="m-0 text-[clamp(1.5rem,2.5vw,2rem)] leading-[1.05] text-white">{headline}</h3>
    <span class="w-fit border-b border-white py-0.5 text-base leading-none text-white transition-colors duration-300 group-hover:border-magenta-soft group-hover:text-magenta-soft">
      {t(locale, 'cta.viewFullCase')}
    </span>
  </div>
</a>
