---
import type {Locale} from '../../i18n/routes'
import {getLocalizedPath} from '../../i18n/routes'
import {t} from '../../i18n'
import Heading from '../ui/Heading.astro'
import Tag from '../ui/Tag.astro'
import TextLink from '../ui/TextLink.astro'

interface Props {
  locale: Locale
  title: string
  excerpt?: string
  slug: string
  categories?: string[]
  category?: string
}

const {locale, title, excerpt, slug, categories, category} = Astro.props
const tags = categories?.length ? categories : category ? [category] : []
---

<article class="border-t border-border pt-6">
  {
    tags.length > 0 && (
      <div class="mb-3 flex flex-wrap gap-2">
        {tags.map((cat) => (
          <Tag>{cat}</Tag>
        ))}
      </div>
    )
  }
  <Heading as="h3" size="h3">{title}</Heading>
  {excerpt && <p class="mt-3 text-navy-muted">{excerpt}</p>}
  <TextLink
    href={getLocalizedPath(locale, 'insight', slug)}
    class="mt-4 inline-flex text-sm"
  >
    {t(locale, 'cta.readInsight')}
  </TextLink>
</article>
