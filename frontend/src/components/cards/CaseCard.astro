---
import type {Locale} from '../../i18n/routes'
import {getLocalizedPath} from '../../i18n/routes'
import type {SanityImageSource} from '@sanity/image-url'
import {t} from '../../i18n'
import {cardMediaLinkClass, linkCtaClass} from '../../lib/interactionClasses'
import {
  caseStudyCardHeadline,
  caseStudyCardOutcome,
  caseStudyCoverUrl,
  caseStudyGridImage,
} from '../../lib/caseStudies'

interface Props {
  locale: Locale
  title: string
  summary?: string
  industry?: string
  service?: string
  challenge?: string
  result?: string
  slug: string
  cover?: string | SanityImageSource
  imageIndex?: number
  class?: string
}

const {
  locale,
  title,
  summary,
  industry,
  service,
  challenge,
  result,
  slug,
  cover,
  imageIndex = 0,
  class: className,
} = Astro.props

const headline = caseStudyCardHeadline({challenge, title})
const outcome = caseStudyCardOutcome({result, summary})
const href = getLocalizedPath(locale, 'caseStudy', slug)
const gridImage = caseStudyGridImage(imageIndex)
const imageSrc = cover ? caseStudyCoverUrl(cover) : gridImage.src
const imageClass = cover
  ? 'absolute inset-0 !h-full !w-full object-cover'
  : gridImage.className
---

<article
  class:list={['group flex h-full min-h-[562px] flex-col overflow-hidden', className]}
>
  <a
    href={href}
    class:list={[cardMediaLinkClass, 'h-[335px] p-6']}
    aria-label={headline}
  >
    <img
      src={imageSrc}
      alt=""
      class:list={[
        'absolute max-w-none transition-[scale] duration-500 ease-[var(--ease-out)] group-hover:scale-[1.025]',
        imageClass,
      ]}
      width="441"
      height="252"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/95 transition-opacity duration-300 ease-[var(--ease-out)] group-hover:opacity-90" />
    {
      industry && (
        <span class="relative inline-flex h-6 items-center rounded-full bg-[#d0dadd] px-3.5 text-sm leading-none text-black">
          {industry}
        </span>
      )
    }
  </a>
  <div class="flex flex-1 flex-col gap-4 p-6 backdrop-blur-[36px]">
    {service && <p class="m-0 text-base leading-normal text-white">{service}</p>}
    <h3 class="m-0 text-xl leading-[1.2]">
      <a href={href} class="case-card-title">
        {headline}
      </a>
    </h3>
    {outcome && <p class="m-0 text-base leading-normal text-white/50">{outcome}</p>}
    <a href={href} class:list={[linkCtaClass, 'mt-auto']}>
      {t(locale, 'cta.viewFullCase')}
    </a>
  </div>
</article>

<style>
  .case-card-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    max-width: 100%;
    color: #fff;
    text-decoration: none;
    text-overflow: ellipsis;
    transition: color 300ms var(--ease-out);
  }

  .case-card-title:hover {
    color: var(--color-magenta-soft);
  }

  .case-card-title:focus-visible {
    outline: 2px solid var(--color-magenta);
    outline-offset: 4px;
  }
</style>
