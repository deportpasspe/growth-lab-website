---
import type {Locale} from '../i18n/routes'
import {getLocalizedPath} from '../i18n/routes'
import {t} from '../i18n'
import {resolveLinkHref} from '../lib/sanity/resolveLink'
import type {NavService, SiteSettings} from '../lib/sanity/types'
import BrandLogo from './ui/BrandLogo.astro'
import Button from './ui/Button.astro'

interface Props {
  locale: Locale
  siteSettings?: SiteSettings | null
  navServices?: NavService[]
}

const {locale, siteSettings = null, navServices = []} = Astro.props
const year = new Date().getFullYear()

const defaultCompanyLinks = [
  {href: getLocalizedPath(locale, 'about'), label: t(locale, 'nav.about')},
  {href: getLocalizedPath(locale, 'methodology'), label: t(locale, 'nav.methodology')},
  {href: getLocalizedPath(locale, 'caseStudies'), label: t(locale, 'nav.caseStudies')},
  {href: getLocalizedPath(locale, 'insights'), label: t(locale, 'nav.insights')},
  {href: getLocalizedPath(locale, 'contact'), label: t(locale, 'nav.contact')},
]

const companyLinks = siteSettings?.footer?.links?.length
  ? siteSettings.footer.links
      .map((item) => ({
        href: resolveLinkHref(item.link, locale),
        label: item.label || item.link?.label || '',
      }))
      .filter((item) => item.href && item.label)
  : defaultCompanyLinks

const fallbackServiceLabels =
  locale === 'es'
    ? [
        'Clima organizacional',
        'Cultura organizacional',
        'Gestión del desempeño',
        'Potencial y mapeo de talento',
        'Liderazgo y coaching',
      ]
    : [
        'Organizational climate',
        'Organizational culture',
        'Performance management',
        'Talent mapping',
        'Leadership and coaching',
      ]

const servicesHref = getLocalizedPath(locale, 'services')
const recruitmentHref = getLocalizedPath(locale, 'recruitment')
const recruitmentLink = {
  label: t(locale, 'contact.form.interestExecutive'),
  href: recruitmentHref,
}
const serviceLinks = navServices.length
  ? navServices.map((service) => ({
      label: service.title,
      href: getLocalizedPath(locale, 'service', service.slug),
    }))
  : fallbackServiceLabels.map((label) => ({label, href: servicesHref}))

const tagline = siteSettings?.footer?.tagline || 'Impact that lasts. Growth that matters.'

const socialIconIds = ['facebook', 'tiktok', 'youtube', 'instagram'] as const
const defaultSocials = socialIconIds.map((id) => ({
  id,
  label: id.charAt(0).toUpperCase() + id.slice(1),
  href: undefined as string | undefined,
}))

const socials = siteSettings?.footer?.socialLinks?.length
  ? siteSettings.footer.socialLinks.map((item) => {
      const label = (item.label || item.link?.label || '').toLowerCase()
      const id = socialIconIds.find((icon) => label.includes(icon)) || 'facebook'
      return {
        id,
        label: item.label || item.link?.label || id,
        href: resolveLinkHref(item.link, locale),
      }
    })
  : defaultSocials

const contactInfo = siteSettings?.footer?.contactInfo
const emailLine = contactInfo?.email
  ? `Email: ${contactInfo.email}`
  : locale === 'es'
    ? 'Email:'
    : 'Email:'
const whatsappLine = contactInfo?.whatsappLabel
  ? `WhatsApp: ${contactInfo.whatsappLabel}`
  : 'WhatsApp:'
const addressLine = contactInfo?.address
  ? contactInfo.address
  : locale === 'es'
    ? 'Dirección:'
    : 'Address:'

const complaintsHref =
  resolveLinkHref(siteSettings?.footer?.complaintsBookLink, locale) || '#'

const footerLinkClass = [
  'group/link relative w-fit text-white/50 no-underline transition-colors duration-300 ease-[var(--ease-out)]',
  'hover:text-white focus-visible:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-magenta',
  'after:absolute after:bottom-[-0.25rem] after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-white',
  'after:transition-transform after:duration-300 after:ease-[var(--ease-out)] hover:after:scale-x-100 focus-visible:after:scale-x-100',
].join(' ')
const socialIconClass =
  '!h-full !w-full max-w-none object-contain transition-[opacity,transform] duration-300 ease-[var(--ease-out)] group-hover/social:scale-110 group-hover/social:opacity-75'
---


<footer
  class="mt-auto overflow-hidden bg-black text-white"
  style="background-color:#000;background-image:radial-gradient(ellipse 110% 120% at 100% 0%,rgba(139,24,88,0.9) 0%,rgba(139,24,88,0.55) 22%,rgba(139,24,88,0.22) 45%,rgba(139,24,88,0.06) 65%,rgba(139,24,88,0) 82%)"
>
  <div class="relative mx-auto hidden h-[594px] w-full max-w-[1440px] min-[1440px]:block" data-reveal-group="130">
    <div class="absolute left-[42.05px] top-[89px] w-[308px]" data-reveal>
      <BrandLogo class="!h-[28.902px] !w-[212.66px]" />
      <p class="m-0 mt-[19px] text-[18px] leading-normal">{tagline}</p>
    </div>

    <div class="absolute left-[42.05px] top-[198.78px] flex h-[22.44px] items-center gap-[16.32px]" aria-label="Social media" data-reveal>
      {
        socials.map((social) => {
          const icon = (
            <img
              src={`/assets/figma/home/social-${social.id}.svg`}
              alt={social.label}
              class={socialIconClass}
              width="22"
              height="22"
            />
          )
          return social.href ? (
            <a
              href={social.href}
              class="group/social relative block h-[22.44px] w-[21.76px] shrink-0 overflow-hidden"
              target="_blank"
              rel="noopener noreferrer"
            >
              {icon}
            </a>
          ) : (
            <span class="group/social relative block h-[22.44px] w-[21.76px] shrink-0 overflow-hidden">{icon}</span>
          )
        })
      }
    </div>

    <div class="absolute left-[42.05px] top-[346px] flex w-[308px] flex-col gap-6 text-[16px] leading-normal" data-reveal>
      <p class="m-0">{emailLine}</p>
      <p class="m-0">{whatsappLine}</p>
      <p class="m-0">{addressLine}</p>
    </div>

    <div class="absolute left-[440px] top-[89px] w-[189px]" data-reveal>
      <h2 class="m-0 text-[20px] font-normal leading-normal">{t(locale, 'nav.recruitment')}</h2>
      <div class="mt-9 flex flex-col gap-4 text-[16px] leading-normal text-white/50">
        <a href={recruitmentLink.href} class={footerLinkClass}>{recruitmentLink.label}</a>
      </div>
    </div>

    <div class="absolute left-[696.5px] top-[89px] w-[189px]" data-reveal>
      <h2 class="m-0 text-[20px] font-normal leading-normal">{t(locale, 'nav.services')}</h2>
      <div class="mt-9 flex flex-col gap-4 text-[16px] leading-normal text-white/50">
        {serviceLinks.map((link) => <a href={link.href} class={footerLinkClass}>{link.label}</a>)}
      </div>
    </div>

    <nav class="absolute left-[1025px] top-[89px] w-[173px]" aria-label="Footer" data-reveal>
      <h2 class="m-0 text-[20px] font-normal leading-normal">{locale === 'es' ? 'Compañía' : 'Company'}</h2>
      <div class="mt-9 flex flex-col gap-4 text-[16px] leading-normal text-white/50">
        {companyLinks.map((link) => <a href={link.href} class={footerLinkClass}>{link.label}</a>)}
      </div>
    </nav>

    <div class="absolute left-[440px] top-[394px] flex items-center gap-6" data-reveal>
      <Button href={getLocalizedPath(locale, 'privacy')} variant="secondary" size="lg">
        {t(locale, 'footer.privacy')}
      </Button>
      <Button href={complaintsHref} variant="secondary" size="lg">
        {locale === 'es' ? 'Libro de reclamaciones' : 'Complaints book'}
      </Button>
    </div>

    <div class="absolute bottom-0 left-[42.5px] flex h-[67px] w-[1355px] items-center border-t border-white/25 px-[10px]" data-reveal>
      <p class="m-0 text-[16px] leading-normal text-white/50">
        © {year} Growth Lab Consulting. {t(locale, 'footer.rights')}
      </p>
    </div>
  </div>

  <div class="mx-auto w-full max-w-[1280px] px-6 py-16 sm:px-[42px] min-[1440px]:hidden" data-reveal-group="120">
    <div class="grid gap-12 md:grid-cols-2 md:items-start md:gap-x-10 xl:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)_minmax(0,1.5fr)_minmax(0,0.95fr)] xl:gap-x-14">
      <div data-reveal>
        <BrandLogo class="!h-[28.902px] !w-[212.66px]" />
        <p class="mb-0 mt-[19px] text-[18px]">{tagline}</p>
        <div class="mt-8 flex items-center gap-4" aria-label="Social media">
          {
            socials.map((social) => {
              const icon = (
                <img
                  src={`/assets/figma/home/social-${social.id}.svg`}
                  alt={social.label}
                  class={socialIconClass}
                  width="22"
                  height="22"
                />
              )
              return social.href ? (
                <a
                  href={social.href}
                  class="group/social block h-[22px] w-[22px] shrink-0 overflow-hidden"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {icon}
                </a>
              ) : (
                <span class="group/social block h-[22px] w-[22px] shrink-0 overflow-hidden">{icon}</span>
              )
            })
          }
        </div>
      </div>

      <div data-reveal>
        <h2 class="m-0 text-[20px]">{t(locale, 'nav.recruitment')}</h2>
        <div class="mt-7 flex flex-col gap-4 text-[16px] text-white/50">
          <a href={recruitmentLink.href} class={footerLinkClass}>{recruitmentLink.label}</a>
        </div>
      </div>

      <div class="md:col-span-2 xl:col-span-1" data-reveal>
        <h2 class="m-0 text-[20px]">{t(locale, 'nav.services')}</h2>
        <div class="mt-7 flex flex-col gap-4 text-[16px] text-white/50">
          {serviceLinks.map((link) => <a href={link.href} class={footerLinkClass}>{link.label}</a>)}
        </div>
      </div>

      <nav aria-label="Footer" class="md:col-span-2 xl:col-span-1" data-reveal>
        <h2 class="m-0 text-[20px]">{locale === 'es' ? 'Compañía' : 'Company'}</h2>
        <div class="mt-7 flex flex-col gap-4 text-[16px] text-white/50">
          {companyLinks.map((link) => <a href={link.href} class={footerLinkClass}>{link.label}</a>)}
        </div>
      </nav>
    </div>

    <div class="mt-12 grid gap-8 border-t border-white/15 pt-10 md:grid-cols-2 md:items-end md:gap-10" data-reveal-group="100">
      <div class="flex flex-col gap-4 text-[16px]" data-reveal>
        <p class="m-0">{emailLine}</p>
        <p class="m-0">{whatsappLine}</p>
        <p class="m-0">{addressLine}</p>
      </div>
      <div class="flex flex-wrap gap-4 md:justify-end" data-reveal>
        <Button href={getLocalizedPath(locale, 'privacy')} variant="secondary" size="lg">
          {t(locale, 'footer.privacy')}
        </Button>
        <Button href={complaintsHref} variant="secondary" size="lg">
          {locale === 'es' ? 'Libro de reclamaciones' : 'Complaints book'}
        </Button>
      </div>
    </div>

    <p class="m-0 mt-10 border-t border-white/25 pt-6 text-[14px] text-white/50">
      © {year} Growth Lab Consulting. {t(locale, 'footer.rights')}
    </p>
  </div>
</footer>
