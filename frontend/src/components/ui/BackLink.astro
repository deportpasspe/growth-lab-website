---
import type {Locale} from '../../i18n/routes'
import {getLocalizedPath} from '../../i18n/routes'
import {t} from '../../i18n'

interface Props {
  locale: Locale
  href?: string
  label?: string
}

const {locale, href = getLocalizedPath(locale, 'insights'), label = t(locale, 'insights.back')} =
  Astro.props
---

<a
  href={href}
  class="inline-flex items-center gap-2.5 text-lg leading-[1.22] text-white no-underline transition-colors duration-300 hover:text-magenta-soft"
>
  <img
    src="/assets/figma/insights/icon-back.svg"
    alt=""
    class="size-7 max-w-none"
    width="28"
    height="28"
  />
  {label}
</a>
