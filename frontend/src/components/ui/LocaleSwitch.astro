---
import type {Locale} from '../../i18n/routes'
import {getAlternateLocalePath} from '../../i18n/routes'

interface Props {
  locale: Locale
  pathAfterLocale?: string
  class?: string
  variant?: 'default' | 'menu'
}

const {locale, pathAfterLocale = '', class: className = '', variant = 'default'} = Astro.props
const alternatePath = getAlternateLocalePath(locale, pathAfterLocale)
const nextLocale: Locale = locale === 'es' ? 'en' : 'es'

const labels = {
  es: {short: 'ES', title: 'Español'},
  en: {short: 'EN', title: 'English'},
} as const

const optionClass = [
  'flex items-center justify-center gap-2.5 rounded-[2px] border px-4 py-3 text-base leading-none no-underline transition-[color,background-color,border-color] duration-300 ease-[var(--ease-out)]',
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-magenta',
].join(' ')

const activeOptionClass = [
  optionClass,
  'border-white/35 bg-white/10 text-white',
].join(' ')

const inactiveOptionClass = [
  optionClass,
  'border-white/20 bg-white/5 text-white/80 hover:border-white/40 hover:bg-white/10 hover:text-white',
].join(' ')
---

{
  variant === 'menu' ? (
    <div class:list={['flex flex-col gap-3', className]}>
      <p class="m-0 text-sm text-white/50">{locale === 'es' ? 'Idioma' : 'Language'}</p>
      <div class="grid grid-cols-2 gap-2" role="group" aria-label={locale === 'es' ? 'Seleccionar idioma' : 'Select language'}>
        <div class={activeOptionClass} aria-current="true">
          <span class="relative block h-3.5 w-5 shrink-0 overflow-hidden rounded-[1px] shadow-[0_0_0_1px_rgba(255,255,255,0.12)]" aria-hidden="true">
            {
              locale === 'es' ? (
                <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
                  <rect width="6" height="12" fill="#C8102E" />
                  <rect x="6" width="6" height="12" fill="#FFFFFF" />
                  <rect x="12" width="6" height="12" fill="#C8102E" />
                </svg>
              ) : (
                <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
                  <rect width="18" height="12" fill="#B22234" />
                  <rect y="1.33" width="18" height="1.33" fill="#FFFFFF" />
                  <rect y="4" width="18" height="1.33" fill="#FFFFFF" />
                  <rect y="6.67" width="18" height="1.33" fill="#FFFFFF" />
                  <rect y="9.33" width="18" height="1.33" fill="#FFFFFF" />
                  <rect width="7.5" height="6.5" fill="#3C3B6E" />
                </svg>
              )
            }
          </span>
          <span>{labels[locale].short}</span>
          <span class="sr-only">{labels[locale].title}</span>
        </div>

        <a href={alternatePath} hreflang={nextLocale} class={inactiveOptionClass} title={labels[nextLocale].title}>
          <span class="relative block h-3.5 w-5 shrink-0 overflow-hidden rounded-[1px] shadow-[0_0_0_1px_rgba(255,255,255,0.12)]" aria-hidden="true">
            {
              nextLocale === 'es' ? (
                <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
                  <rect width="6" height="12" fill="#C8102E" />
                  <rect x="6" width="6" height="12" fill="#FFFFFF" />
                  <rect x="12" width="6" height="12" fill="#C8102E" />
                </svg>
              ) : (
                <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
                  <rect width="18" height="12" fill="#B22234" />
                  <rect y="1.33" width="18" height="1.33" fill="#FFFFFF" />
                  <rect y="4" width="18" height="1.33" fill="#FFFFFF" />
                  <rect y="6.67" width="18" height="1.33" fill="#FFFFFF" />
                  <rect y="9.33" width="18" height="1.33" fill="#FFFFFF" />
                  <rect width="7.5" height="6.5" fill="#3C3B6E" />
                </svg>
              )
            }
          </span>
          <span>{labels[nextLocale].short}</span>
          <span class="sr-only">{labels[nextLocale].title}</span>
        </a>
      </div>
    </div>
  ) : (
<details class:list={['group/locale relative w-fit', className]} data-locale-switch>
  <summary
    class={[
      'flex h-11 cursor-pointer list-none items-center gap-2 rounded-[2px] border border-white/20 bg-white/5 px-3',
      'transition-[color,background-color,border-color,transform,box-shadow] duration-300 ease-[var(--ease-out)]',
      'marker:content-none hover:-translate-y-px hover:border-white/40 hover:bg-white/10 hover:shadow-[0_8px_20px_rgba(0,0,0,0.25)]',
      'active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-magenta',
      'group-open/locale:border-white/35 group-open/locale:bg-white/10 [&::-webkit-details-marker]:hidden',
    ].join(' ')}
    aria-label={locale === 'es' ? 'Cambiar idioma' : 'Change language'}
  >
    <span class="relative block h-3.5 w-5 shrink-0 overflow-hidden rounded-[1px] shadow-[0_0_0_1px_rgba(255,255,255,0.12)]" aria-hidden="true">
      {
        locale === 'es' ? (
          <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
            <rect width="6" height="12" fill="#C8102E" />
            <rect x="6" width="6" height="12" fill="#FFFFFF" />
            <rect x="12" width="6" height="12" fill="#C8102E" />
          </svg>
        ) : (
          <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
            <rect width="18" height="12" fill="#B22234" />
            <rect y="1.33" width="18" height="1.33" fill="#FFFFFF" />
            <rect y="4" width="18" height="1.33" fill="#FFFFFF" />
            <rect y="6.67" width="18" height="1.33" fill="#FFFFFF" />
            <rect y="9.33" width="18" height="1.33" fill="#FFFFFF" />
            <rect width="7.5" height="6.5" fill="#3C3B6E" />
          </svg>
        )
      }
    </span>
    <span class="text-[11px] font-medium leading-none tracking-[0.08em] text-white/85">{labels[locale].short}</span>
    <svg
      width="10"
      height="6"
      viewBox="0 0 10 6"
      fill="none"
      class="shrink-0 text-white/70 transition-transform duration-300 ease-[var(--ease-out)] group-open/locale:-rotate-180"
      aria-hidden="true"
    >
      <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>

  <div
    class={[
      'absolute right-0 top-[calc(100%+8px)] z-50 min-w-[128px] origin-top-right overflow-hidden rounded-[2px] border border-white/15 bg-black py-1',
      'shadow-[0_16px_40px_rgba(0,0,0,0.5)]',
      'opacity-0 scale-95 translate-y-1 transition-[opacity,transform] duration-300 ease-[var(--ease-out)]',
      'group-open/locale:opacity-100 group-open/locale:scale-100 group-open/locale:translate-y-0',
    ].join(' ')}
  >
    <div class="flex items-center gap-2.5 px-3 py-2.5 text-[12px] text-white/40" aria-current="true">
      <span class="relative block h-3 w-[18px] shrink-0 overflow-hidden rounded-[1px]" aria-hidden="true">
        {
          locale === 'es' ? (
            <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
              <rect width="6" height="12" fill="#C8102E" />
              <rect x="6" width="6" height="12" fill="#FFFFFF" />
              <rect x="12" width="6" height="12" fill="#C8102E" />
            </svg>
          ) : (
            <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
              <rect width="18" height="12" fill="#B22234" />
              <rect y="1.33" width="18" height="1.33" fill="#FFFFFF" />
              <rect y="4" width="18" height="1.33" fill="#FFFFFF" />
              <rect y="6.67" width="18" height="1.33" fill="#FFFFFF" />
              <rect y="9.33" width="18" height="1.33" fill="#FFFFFF" />
              <rect width="7.5" height="6.5" fill="#3C3B6E" />
            </svg>
          )
        }
      </span>
      {labels[locale].short}
    </div>

    <a
      href={alternatePath}
      hreflang={nextLocale}
      class="flex items-center gap-2.5 px-3 py-2.5 text-[12px] text-white no-underline transition-[background-color,transform] duration-300 ease-[var(--ease-out)] hover:bg-white/10 hover:translate-x-0.5 focus-visible:bg-white/10 focus-visible:outline-none"
      title={labels[nextLocale].title}
    >
      <span class="relative block h-3 w-[18px] shrink-0 overflow-hidden rounded-[1px]" aria-hidden="true">
        {
          nextLocale === 'es' ? (
            <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
              <rect width="6" height="12" fill="#C8102E" />
              <rect x="6" width="6" height="12" fill="#FFFFFF" />
              <rect x="12" width="6" height="12" fill="#C8102E" />
            </svg>
          ) : (
            <svg viewBox="0 0 18 12" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
              <rect width="18" height="12" fill="#B22234" />
              <rect y="1.33" width="18" height="1.33" fill="#FFFFFF" />
              <rect y="4" width="18" height="1.33" fill="#FFFFFF" />
              <rect y="6.67" width="18" height="1.33" fill="#FFFFFF" />
              <rect y="9.33" width="18" height="1.33" fill="#FFFFFF" />
              <rect width="7.5" height="6.5" fill="#3C3B6E" />
            </svg>
          )
        }
      </span>
      {labels[nextLocale].short}
      <span class="sr-only">{labels[nextLocale].title}</span>
    </a>
  </div>
</details>
  )
}

<script>
  const switches = document.querySelectorAll<HTMLDetailsElement>('[data-locale-switch]')

  switches.forEach((details) => {
    document.addEventListener('click', (event) => {
      if (!details.open) return
      if (event.target instanceof Node && details.contains(event.target)) return
      details.open = false
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) details.open = false
    })
  })
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    :global(.group\/locale summary),
    :global(.group\/locale summary svg),
    :global(.group\/locale > div),
    :global(.group\/locale a) {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
