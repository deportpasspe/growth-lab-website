---
interface Props {
  id?: string
  class?: string
  tone?: 'default' | 'cream' | 'navy' | 'teal' | 'black'
}

const {id, class: className = '', tone = 'default'} = Astro.props

const tones = {
  default: 'bg-black text-white',
  cream: 'bg-cream-pale text-navy',
  black: 'bg-black text-white',
  navy: 'bg-navy text-white',
  teal: 'bg-teal text-white',
}
---

<section id={id} class:list={['py-16 sm:py-24', tones[tone], className]}>
  <slot />
</section>
