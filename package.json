{
  "name": "growth-lab-website",
  "description": "Growth Lab — bilingual consulting website (Astro + Sanity)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=studio\"",
    "build": "npm run build --workspace=studio && npm run build --workspace=frontend",
    "check": "npm run check --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "format": "prettier --write \"frontend/src/**/*.{ts,astro,css,json}\" \"studio/src/**/*.{ts,tsx}\"",
    "test:e2e": "playwright test",
    "typegen": "cd studio && npx sanity@latest schema extract --path=../frontend/schema.json --force && npx sanity@latest typegen generate",
    "seed": "tsx studio/scripts/seed.ts",
    "migrate:i18n": "tsx studio/scripts/migrate-i18n-field-level.ts",
    "migrate:i18n:v5": "tsx studio/scripts/migrate-i18n-v5-language-field.ts",
    "repair:i18n": "tsx studio/scripts/repair-i18n-data.ts",
    "validate:i18n": "tsx studio/scripts/validate-i18n-data.ts",
    "validate:audit": "tsx studio/scripts/audit-data.ts",
    "patch:seo": "tsx studio/scripts/patch-seo.ts",
    "validate:seo": "tsx studio/scripts/patch-seo.ts",
    "validate:images": "tsx studio/scripts/validate-images.ts"
  },
  "workspaces": [
    "studio",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.5"
  }
}
